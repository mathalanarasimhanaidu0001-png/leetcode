387. First Unique Character in a String
LEET CODE STYLE

class Solution {
public:
    int firstUniqChar(string s) {
        vector<int> freq(26,0);

        for(int i=0;i<s.size();i++){
            char curr_letter=s[i];
            int index = curr_letter -'a';

            freq[index]++;
        }

        for(int i=0;i<s.size();i++){
            char curr_letter=s[i];
            int index = curr_letter - 'a';
            if(freq[index] ==1){
                return i;
            }
        }
        return-1;
        
    }
};

tcs/infosys style

#include<iostream>
#include<string>
#include<vector>
using namespace std;

class Solution{
    public:
    
    int first_uniq(string s){
        vector<int> freq(26,0);
        
        for(int i=0;i<s.size();i++){
            char curr_letter = s[i];
            int index = curr_letter - 'a';
            freq[index]++;
        }
        
        for(int i=0;i<s.size();i++){
            char curr_letter = s[i];
            int index = curr_letter - 'a';
            if(freq[index]==1){
                return i;
            }
            
        }
        return -1;
    }
};

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    cin>>n;
    
    vector<char> s(n);
    for(int i=0;i< s.size();i++){
        cin>>s[i];
    }
    
    Solution obj;
    int result = obj.first_uniq(string  (s.begin(),s.end()));
    cout<<result;
    
}
