#include<iostream>
#include<string>
using namespace std;
 class Solution{
     public:
     void length_of_string(){
         string text="SUPER MAN";
         cout<<text.length()<<"\n";
         char first=text.at(0);
         char last=text.back();
         cout<<first <<"  "<< last << "\n";
         
         for(int i=0;i<text.size();i++){
             cout<<text[i]<<"    " << "\n";
             
             
         }
         
         for(char c:text){
             cout<<c<<"    ";
         }
     }
 };
 
