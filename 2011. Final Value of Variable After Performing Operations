2011. Final Value of Variable After Performing Operations
(LEET CODE style)

class Solution {
public:
    int finalValueAfterOperations(vector<string>& operations) {
        
        ios_base::sync_with_stdio(false);
        cin.tie(NULL);
        int x=0;
        int n=operations.size();
        for(int i=0;i<n;i++){
            if(operations[i][1] == '+'){
                x++;
            }
            else{
                x--;
            }

        }
        return x;

        }
};


 (TCS / INFOSYS style)

#include<bits/stdc++.h>
using namespace std;

class solution{
    public:
    
    int finalvalueafteroperations(vector<string>& operations){
        
        int X = 0;
        int n = operations.size();
        
        for(int i=0;i<n;i++){
            if(operations[i]=="X++" || operations[i]=="++X"){
                X++;
            }
            else{
                X--;
            }
        }
        return X;
    }
};

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int n;
    cin>>n;
    
    vector<string> operations(n);
    for(int i=0;i<n;i++){
        cin>>operations[i];
    }
    solution obj;
    int result = obj.finalvalueafteroperations(operations);
    cout<<result<<'\n';
     return 0;
}
