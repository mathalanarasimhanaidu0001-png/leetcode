[  n = n & (n-1) ] - PATTERN TRICK
 leetcode solution 

 #include<iostream>
using namespace std;

class Solution {
public:
    int hammingWeight(int n) {
        int count = 0;
    
        while (n != 0) {
            n = n & (n - 1);
            count++;
        }
        return count;
    }
};

.. tcs nqt solution 


#include <iostream>
using namespace std;

int main() {
    // Fast I/O optimization for exam test cases
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    
    // Read the input value from the TCS test case
    if (cin >> n) {
        int count = 0;
        
        // Brian Kernighan's Algorithm: clearing the rightmost set bit
        while (n != 0) {
            n = n & (n - 1); // Clears the rightmost 1-bit
            count++;          // Increments total set bit count
        }
        
        // Print ONLY the answer (no additional text)
        cout << count << "\n";
    }

    return 0;
}
