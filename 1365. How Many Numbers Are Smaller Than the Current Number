1365. How Many Numbers Are Smaller Than the Current Number

(LEET CODE STYLE )

class Solution {
public:
    vector<int> smallerNumbersThanCurrent(vector<int>& nums) {

        ios_base::sync_with_stdio(false);
        cin.tie(NULL);

        vector<int> ans;


        for(int i=0;i<nums.size();i++){
            int count=0;

            for(int j=0;j<nums.size();j++){
                if(j != i && nums[j]<nums[i]){
                     count++;
                }
            }
            ans.push_back(count);

        }
        return ans;
    }
};

(INFOSYS / TCS style )

#include<iostream>
#include<vector>
using namespace std;

class Solution{
    public:
    
    vector<int> smaller_than_current_number(vector<int>& nums){
        
        vector<int> ans;
        
        for(int i=0;i<nums.size();i++){
            int count=0;
            for(int j=0;j<nums.size();j++){
                if(j != i && nums[i]>nums[j]){
                    count++;
                }
            }
            ans.push_back(count);
        }
        return ans;
    }
};

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int n;
    cin>>n;
    vector<int> nums(n);
    
    
    for( int i=0 ; i<n;i++){
        cin>>nums[i];
    }
    
    
    Solution obj;
    vector<int> result = obj.smaller_than_current_number(nums);
    
    for(int i =0;i<n ;i++){
        cout<<result[i];
    }
    
    return 0;
}
