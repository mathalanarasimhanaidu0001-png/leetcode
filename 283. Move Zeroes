(BRUTE FORCE METHOD)

#include<iostream>
#include<vector>
using namespace std;
class Solution{
    public:
    
    void movezeros(vector<int>& nums){ // no xtra array so "void" return 
        int n = nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]==0){
               for(int j=i+1;j<n;j++){
                if(nums[j]!=0){
                    swap(nums[j],nums[i]);
                    break;
                }
            }}
        }
    }
};
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int n;
    cin>>n;
    vector<int> nums(n);      // creates the original input array, not an extra array.
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    
    
    Solution obj;
    obj.movezeros(nums); // as we know "no return type so no int or any type beside this line "
    for(int i=0;i<nums.size();i++){
        cout<<nums[i]<<"  ";}
}
